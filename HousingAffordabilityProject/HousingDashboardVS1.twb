    <worksheet name='Home Market Activity'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Low Activity Threshold for Houses</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Low Sales/Rental Activity' name='federated.1nl3jk70v0lmwd1c50bzt0yrtm3g' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Home Threshold Pct' datatype='real' name='[Parameter 1483017141665828]' param-domain-type='range' role='measure' type='quantitative' value='0.34999999999999998'>
              <calculation class='tableau' formula='0.34999999999999998' />
              <range granularity='0.05' max='0.7' min='0.1' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1nl3jk70v0lmwd1c50bzt0yrtm3g'>
            <column caption='Latest MonthKey' datatype='integer' name='[Calculation_1483017081507842]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX([MonthKey])' />
            </column>
            <column caption='Home Activity Status' datatype='string' name='[Calculation_1483017111851032]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ZN([HomesSold]) &gt; [Calculation_1483017141870629] &#13;&#10;THEN &quot;Normal Activity&quot; &#13;&#10;ELSE &quot;Low Sales&quot; &#13;&#10;END' />
            </column>
            <column caption='Dynamic Home Threshold Cutoff' datatype='real' name='[Calculation_1483017141870629]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [PropertyTypeName] : MAX([HomesSold]) } * [Parameters].[Parameter 1483017141665828]' />
            </column>
            <column caption='Homes Sold' datatype='integer' name='[HomesSold]' role='measure' type='quantitative' />
            <column caption='Market Name' datatype='string' name='[MarketName]' role='dimension' type='nominal' />
            <column caption='Month Key' datatype='integer' name='[MonthKey]' role='dimension' type='ordinal' />
            <column caption='Property Type Name' datatype='string' name='[PropertyTypeName]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Condo/Townhome&quot;' value='Condo or Townhome' />
              </aliases>
            </column>
            <column-instance column='[HomesSold]' derivation='Avg' name='[avg:HomesSold:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1483017111851032]' derivation='None' name='[none:Calculation_1483017111851032:nk]' pivot='key' type='nominal' />
            <column-instance column='[MarketName]' derivation='None' name='[none:MarketName:nk]' pivot='key' type='nominal' />
            <column-instance column='[PropertyTypeName]' derivation='None' name='[none:PropertyTypeName:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1483017081507842]' derivation='User' name='[usr:Calculation_1483017081507842:qk]' pivot='key' type='quantitative' />
