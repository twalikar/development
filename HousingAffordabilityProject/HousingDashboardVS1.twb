      </column>
      <column caption='Available Cost' datatype='real' name='[Calculation_1483017083080711]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([MedianSalePrice], [MedianAskingRent])' />
      </column>
      <column caption='Home Activity Status' datatype='string' name='[Calculation_1483017111851032]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ZN([HomesSold]) &gt; [Calculation_1483017141870629] &#13;&#10;THEN &quot;Normal Activity&quot; &#13;&#10;ELSE &quot;Low Sales&quot; &#13;&#10;END' />
      </column>
      <column caption='Rental Activity Status' datatype='string' name='[Calculation_1483017112121369]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [ActiveRentalListings] &gt; [Calculation_1483017119612960] &#13;&#10;THEN &quot;Normal Activity&quot; &#13;&#10;ELSE &quot;Low Rentals&quot; &#13;&#10;END' />
      </column>
      <column caption='Dynamic Rental Threshold Cutoff' datatype='real' name='[Calculation_1483017119612960]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [PropertyTypeName] : MAX([ActiveRentalListings]) } * [Parameters].[Parameter 1483017119391775]' />
      </column>
      <column caption='Dynamic Home Threshold Cutoff' datatype='real' name='[Calculation_1483017141870629]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [PropertyTypeName] : MAX([HomesSold]) } * [Parameters].[Parameter 1483017141665828]' />
      </column>
