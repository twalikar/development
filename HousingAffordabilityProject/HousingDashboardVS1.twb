    <worksheet name='Rental Market Activity'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Low Activity Threshold for Rentals</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Low Sales/Rental Activity' name='federated.1nl3jk70v0lmwd1c50bzt0yrtm3g' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Rental Threshold Pct' datatype='real' name='[Parameter 1483017119391775]' param-domain-type='range' role='measure' type='quantitative' value='0.34999999999999998'>
              <calculation class='tableau' formula='0.34999999999999998' />
              <range granularity='0.05' max='0.5' min='0.15' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1nl3jk70v0lmwd1c50bzt0yrtm3g'>
            <column caption='Active Rental Listings' datatype='integer' name='[ActiveRentalListings]' role='measure' type='quantitative' />
            <column caption='Latest MonthKey' datatype='integer' name='[Calculation_1483017081507842]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX([MonthKey])' />
            </column>
            <column caption='Rental Activity Status' datatype='string' name='[Calculation_1483017112121369]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [ActiveRentalListings] &gt; [Calculation_1483017119612960] &#13;&#10;THEN &quot;Normal Activity&quot; &#13;&#10;ELSE &quot;Low Rentals&quot; &#13;&#10;END' />
            </column>
            <column caption='Dynamic Rental Threshold Cutoff' datatype='real' name='[Calculation_1483017119612960]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [PropertyTypeName] : MAX([ActiveRentalListings]) } * [Parameters].[Parameter 1483017119391775]' />
            </column>
            <column caption='Market Name' datatype='string' name='[MarketName]' role='dimension' type='nominal' />
