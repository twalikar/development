    <worksheet name='Monthly Mortgage Payment in 2026'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Estimated Monthly Mortgage Payment in 2026 for Each Property Type</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run>Figures reflect principal and interest only. Does not include property taxes, homeowners insurance, PMI, or HOA fees. Average of Estimated Monthly Principal Interest for each Market Name broken down by Property Type Name.  Color shows details about Market Name.  The marks are labeled by average of Estimated Monthly Principal Interest. The data is filtered on Month Key, which keeps 8 months of 2026.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='vw_HomeBuyingAffordability (HousingAffordabilityAnalytics)' name='federated.04q34g2075rlic1e8xeh313q5qk5' />
          </datasources>
          <datasource-dependencies datasource='federated.04q34g2075rlic1e8xeh313q5qk5'>
            <column datatype='real' name='[EstimatedDownPayment20Pct]' role='measure' type='quantitative' />
            <column caption='Estimated Loan Amount' datatype='real' name='[EstimatedLoanAmount]' role='measure' type='quantitative' />
            <column caption='Estimated Monthly Principal Interest' datatype='real' name='[EstimatedMonthlyPrincipalInterest]' role='measure' type='quantitative' />
            <column caption='Market Name' datatype='string' name='[MarketName]' role='dimension' type='nominal' />
            <column caption='Median Sale Price' datatype='real' name='[MedianSalePrice]' role='measure' type='quantitative' />
            <column caption='Month Key' datatype='integer' name='[MonthKey]' role='dimension' type='ordinal' />
            <column datatype='real' name='[MortgageRate30YrPct]' role='measure' type='quantitative' />
